{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact gendered asymmetric visibility benchmark response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "rv": {"enum": ["v", "t", "u"]},
    "stage": {"enum": ["v", "a", "q", "na"]},
    "position": {"enum": ["f", "m", "g", "x", "r", "u", "n", "q", "na"]},
    "actorRealization": {"enum": ["eg", "eu", "gc", "za", "po", "ne", "no", "q", "na"]},
    "authorization": {"enum": ["y", "n", "m", "0", "q", "na"]},
    "support": {
      "type": "array",
      "prefixItems": [{"type": "string"}, {"type": "string"}],
      "minItems": 2,
      "maxItems": 2
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s", "q"],
      "properties": {
        "s": {"type": "string", "minLength": 1, "maxLength": 160},
        "q": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/support"}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["i", "rv", "cv", "ct", "dv", "da", "dr", "dt", "au", "ev", "et", "ob", "de", "pl", "rr", "sp", "ar", "e"],
      "properties": {
        "i": {"type": "integer", "minimum": 1},
        "rv": {"$ref": "#/$defs/rv"},
        "cv": {"$ref": "#/$defs/stage"},
        "ct": {"$ref": "#/$defs/position"},
        "dv": {"$ref": "#/$defs/stage"},
        "da": {"$ref": "#/$defs/position"},
        "dr": {"$ref": "#/$defs/actorRealization"},
        "dt": {"$ref": "#/$defs/position"},
        "au": {"$ref": "#/$defs/authorization"},
        "ev": {"$ref": "#/$defs/stage"},
        "et": {"$ref": "#/$defs/position"},
        "ob": {"$ref": "#/$defs/position"},
        "de": {"$ref": "#/$defs/position"},
        "pl": {"$ref": "#/$defs/position"},
        "rr": {"$ref": "#/$defs/position"},
        "sp": {"$ref": "#/$defs/position"},
        "ar": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "e": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
