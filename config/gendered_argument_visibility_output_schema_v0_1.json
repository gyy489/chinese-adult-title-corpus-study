{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gendered argument visibility annotation output v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_validity", "person_reference_status", "participant_configuration", "visible_gender_positions", "person_focus_position",
    "sexual_action_visibility", "sexual_action_actor_position", "sexual_action_target_position", "sexual_action_actor_realization", "sexual_action_target_realization",
    "control_visibility", "control_form", "control_actor_position", "control_target_position", "control_actor_realization", "control_target_realization",
    "desire_holder_position", "pleasure_holder_position", "refusal_resistance_position", "consent_visibility", "attributed_speech_position", "attributed_speech_act",
    "objectification_target_position", "editorial_framing_cues", "context_frame_codes",
    "privacy_chain_relevance", "material_creation_visibility", "material_creation_actor_position", "material_creation_target_position",
    "acquisition_visibility", "acquisition_actor_position", "acquisition_target_position", "distribution_visibility", "distribution_actor_position", "distribution_target_position",
    "exposure_visibility", "exposure_target_position", "distribution_authorization_visibility",
    "needs_adjudication", "adjudication_reasons", "evidence"
  ],
  "properties": {
    "record_validity": {"enum":["valid","technical_noise","unknown"]},
    "person_reference_status": {"enum":["visible","absent","unclear","not_applicable"]},
    "participant_configuration": {"enum":["none","single","dyad","group","unclear","not_applicable"]},
    "visible_gender_positions": {"type":"array","uniqueItems":true,"items":{"enum":["feminine","masculine","gender_diverse","gender_unspecified"]}},
    "person_focus_position": {"enum":["feminine","masculine","gender_diverse","mixed_multiple","gender_unspecified","not_visible","unclear","not_applicable","no_person_focus"]},
    "sexual_action_visibility": {"enum":["explicit","implied","absent","unclear","not_applicable"]},
    "sexual_action_actor_position": {"$ref":"#/$defs/position"},
    "sexual_action_target_position": {"$ref":"#/$defs/position"},
    "sexual_action_actor_realization": {"$ref":"#/$defs/actorRealization"},
    "sexual_action_target_realization": {"$ref":"#/$defs/targetRealization"},
    "control_visibility": {"enum":["explicit","implied","absent","unclear","not_applicable"]},
    "control_form": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["overt_force","restraint_or_confinement","command_or_discipline","threat","deception_or_incapacity","authority_or_economic_leverage","role_label_only","none_visible","unclear","not_applicable"]}},
    "control_actor_position": {"$ref":"#/$defs/position"},
    "control_target_position": {"$ref":"#/$defs/position"},
    "control_actor_realization": {"$ref":"#/$defs/actorRealization"},
    "control_target_realization": {"$ref":"#/$defs/targetRealization"},
    "desire_holder_position": {"$ref":"#/$defs/position"},
    "pleasure_holder_position": {"$ref":"#/$defs/position"},
    "refusal_resistance_position": {"$ref":"#/$defs/position"},
    "consent_visibility": {"enum":["affirmative_explicit","refusal_or_nonconsent_explicit","negotiated_or_mixed","no_visible_consent_language","unclear","not_applicable"]},
    "attributed_speech_position": {"$ref":"#/$defs/position"},
    "attributed_speech_act": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["direct_quote","request_or_invitation","command","refusal_or_protest","reported_desire_or_feeling","evaluation","no_visible_attributed_speech","unclear","not_applicable"]}},
    "objectification_target_position": {"$ref":"#/$defs/position"},
    "editorial_framing_cues": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["erotic_promotional_approval","novelty_or_sensationalization","authenticity_or_voyeurism","mockery_or_humiliation","moral_condemnation","neutral_catalogue","no_visible_editorial_frame","unclear","not_applicable"]}},
    "context_frame_codes": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["explicit_roleplay_or_bdsm","relationship_entitlement_explicit","institutional_hierarchy_explicit","economic_transaction_explicit","incapacity_or_deception_explicit","force_or_threat_explicit","aftermath_consequence_or_help_seeking","none_visible","unclear","not_applicable"]}},
    "privacy_chain_relevance": {"enum":["relevant","not_relevant","unclear","not_applicable"]},
    "material_creation_visibility": {"$ref":"#/$defs/stageVisibility"},
    "material_creation_actor_position": {"$ref":"#/$defs/position"},
    "material_creation_target_position": {"$ref":"#/$defs/position"},
    "acquisition_visibility": {"$ref":"#/$defs/stageVisibility"},
    "acquisition_actor_position": {"$ref":"#/$defs/position"},
    "acquisition_target_position": {"$ref":"#/$defs/position"},
    "distribution_visibility": {"$ref":"#/$defs/stageVisibility"},
    "distribution_actor_position": {"$ref":"#/$defs/position"},
    "distribution_target_position": {"$ref":"#/$defs/position"},
    "exposure_visibility": {"$ref":"#/$defs/stageVisibility"},
    "exposure_target_position": {"$ref":"#/$defs/position"},
    "distribution_authorization_visibility": {"enum":["authorized_explicit","unauthorized_explicit","mixed_or_stage_conflict","no_visible_authorization_language","unclear","not_applicable"]},
    "needs_adjudication": {"type":"boolean"},
    "adjudication_reasons": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":240}},
    "evidence": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["span","supports"],"properties":{"span":{"type":"string","minLength":1,"maxLength":160},"supports":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["field","code"],"properties":{"field":{"type":"string"},"code":{"type":"string"}}}}}}}
  },
  "$defs": {
    "position": {"enum":["feminine","masculine","gender_diverse","mixed_multiple","mutual_or_reciprocal","gender_unspecified","not_visible","unclear","not_applicable"]},
    "actorRealization": {"enum":["explicit_gendered_person_or_role","explicit_ungendered_person_or_role","deidentified_placeholder","zero_anaphora_coreferential","passive_agent_omitted","generic_or_collective_actor","event_visible_actor_not_visible","unclear","not_applicable"]},
    "targetRealization": {"enum":["explicit_person_or_role","pronoun_or_deictic","body_part_fragment","zero_anaphora_coreferential","object_omitted","unclear","not_applicable"]},
    "stageVisibility": {"enum":["visible","absent","unclear","not_applicable"]}
  }
}
